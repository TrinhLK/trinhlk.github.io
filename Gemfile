source 'https://rubygems.org'

# Local build tooling. GitHub Pages uses its own pinned Jekyll for the
# production build and only reads the `jekyll_plugins` group from this file.
gem 'jekyll', '~> 3.9.3'
gem 'kramdown-parser-gfm'
# Needed by `jekyll serve` on modern Ruby (no longer a default gem)
gem 'webrick'
# Ruby 2.6 compatibility pins
gem 'ffi', '~> 1.15.5'
gem 'public_suffix', '~> 4.0'